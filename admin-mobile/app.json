{
  "expo": {
    "name": "Mpanko Admin",
    "slug": "mpanko-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wolbiroyal.mpankoadmin"
    },
    "android": {
      "package": "com.wolbiroyal.mpankoadmin",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "scheme": "mpanko-admin",
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mpanko Admin needs your photos so you can attach pictures to products and shipments.",
          "cameraPermission": "Mpanko Admin needs your camera so you can take photos of products and proof of delivery."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6bd03d5a-07b6-49a5-a95e-f172ec9bce77"
      }
    },
    "owner": "mohammedawal"
  }
}
