{
  "expo": {
    "name": "Mpanko",
    "slug": "mpanko",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wolbiroyal.mpanko"
    },
    "android": {
      "package": "com.wolbiroyal.mpanko",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:8000/api/v1",
      "eas": {
        "projectId": "e9a5bc3f-f25b-4fa9-bd01-5e0ebfa7cdf9"
      }
    },
    "scheme": "mpanko",
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0E7F74"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "owner": "mohammedawal",
    "icon": "./assets/icon.png"
  }
}
