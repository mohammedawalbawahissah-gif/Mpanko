# Copy to .env and fill in. Never commit .env.
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string-of-50-plus-characters
ALLOWED_HOSTS=localhost,127.0.0.1,.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# Leave blank locally to use SQLite; Railway Postgres injects DATABASE_URL automatically.
DATABASE_URL=
# Leave blank locally (tasks run inline); on Railway add the Redis service URL.
REDIS_URL=

# Commerce — confirm with the client (OD-04, OD-09)
BASE_CURRENCY=USD
# ALL = every world currency we hold a rate for, or list codes such as USD,GHS,EUR
SUPPORTED_CURRENCIES=ALL
MANUAL_FX_RATES=GHS=11.65
SHIPPING_FLAT_RATE=15.00
TAX_RATE=0

# Payments — use "mock" locally, "paystack" in production
PAYMENT_PROVIDERS_ENABLED=mock
PAYSTACK_SECRET_KEY=
PAYMENT_RETURN_URL=http://localhost:5173/checkout/complete
FRONTEND_URL=http://localhost:5173

# Email — console backend prints emails to the terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Mpanko <no-reply@yourdomain.com>

# Extra people (comma separated) to email when stock runs low. Store admins always get them.
STAFF_ALERT_EMAILS=

# Email — Resend (https://resend.com). With a key set, email goes out through Resend's SMTP.
RESEND_API_KEY=
# Verify your domain in Resend, then use an address on it, e.g. Mpanko <orders@yourdomain.com>

# Permanent image and label storage — Cloudflare R2. Leave blank to store files on the server disk (lost on redeploy).
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public URL of the bucket, e.g. https://images.yourdomain.com or https://pub-xxxx.r2.dev
R2_PUBLIC_URL=

# Carriers — leave blank until you have accounts. CARRIER_SANDBOX=true uses each carrier's test servers.
CARRIER_SANDBOX=true
SHIP_FROM_NAME=Mpanko
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=
SHIP_FROM_LINE1=
SHIP_FROM_CITY=Tamale
SHIP_FROM_REGION=
SHIP_FROM_POSTAL_CODE=
SHIP_FROM_COUNTRY=GH
# Default box size in cm (length,width,height) used for quotes
PARCEL_DEFAULT_CM=30,20,10
DHL_API_KEY=
DHL_EXPRESS_USER=
DHL_EXPRESS_PASSWORD=
DHL_EXPRESS_ACCOUNT=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT=

# Returns — days after delivery a customer can ask to return items; allow "changed my mind" returns
RETURN_WINDOW_DAYS=14
RETURN_ALLOW_CHANGED_MIND=true

# Business details printed on invoices and in the policy pages (client's accountant/lawyer to confirm)
STORE_LEGAL_NAME=Wolbi Royal Enterprise
STORE_ADDRESS=Tamale, Ghana
STORE_TAX_ID=
# Data retention (runs daily on the beat service)
RETENTION_UNVERIFIED_DAYS=30
RETENTION_LOG_DAYS=180
RETENTION_CLOSED_SUPPORT_DAYS=730
RETENTION_ORDER_YEARS=7

# Mobile deep links and push (optional)
APP_SCHEME=mpanko
EXPO_ACCESS_TOKEN=

# --- Tax, duties and parcels ---
# "estimate" shows likely import duty and leaves it for the buyer to pay on delivery (DDU).
# "prepaid" adds it to the order total and you settle it with the carrier (DDP).
DUTIES_MODE=estimate
# Volumetric weight = length x width x height (cm) / this number. 5000 is the usual courier value.
VOLUMETRIC_DIVISOR=5000
# Carrier codes (comma separated) that accept dangerous goods even if the rate row is not ticked.
DANGEROUS_GOODS_CARRIERS=

# --- SMS sign-in codes and text updates ---
# "log" writes messages to the server log (development). "twilio" sends real texts.
SMS_BACKEND=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sender id / number ...
TWILIO_FROM=
# ... or a Messaging Service SID (preferred for several countries).
TWILIO_MESSAGING_SERVICE_SID=

# --- Error tracking (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
