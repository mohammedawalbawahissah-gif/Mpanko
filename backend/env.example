# Copy to .env and fill in. Never commit .env.
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string-of-50-plus-characters
ALLOWED_HOSTS=localhost,127.0.0.1,.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# Leave blank locally to use SQLite; Railway Postgres injects DATABASE_URL automatically.
DATABASE_URL=
# Leave blank locally (tasks run inline); on Railway add the Redis service URL.
REDIS_URL=

# Commerce — confirm with the client (OD-04, OD-09)
BASE_CURRENCY=USD
SUPPORTED_CURRENCIES=USD,GHS
MANUAL_FX_RATES=GHS=11.65
SHIPPING_FLAT_RATE=15.00
TAX_RATE=0

# Payments — use "mock" locally, "paystack" in production
PAYMENT_PROVIDERS_ENABLED=mock
PAYSTACK_SECRET_KEY=
PAYMENT_RETURN_URL=http://localhost:5173/checkout/complete
FRONTEND_URL=http://localhost:5173

# Email — console backend prints emails to the terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Mpanko <no-reply@yourdomain.com>
